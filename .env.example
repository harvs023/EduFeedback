# ==============================================================================
# EduFeedback Environment Configuration
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini sentiment analysis of survey comments (server only).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_SENTIMENT_MODEL: Optional. The one fixed Gemini model used for sentiment
# (default gemini-3.1-flash-lite). Do not change it during or after the thesis evaluation.
GEMINI_SENTIMENT_MODEL=""

# RESULT_SIGNING_SECRET: Required. A long random secret (at least 32 characters) the server
# uses to sign every sentiment result, so a label changed in a browser is detected.
# Server only: never rename it to VITE_..., never commit the real value.
# Use the SAME value everywhere that shares this Firebase database (your computer and the host).
# If it changes, every saved result shows as "needs a re-run" until re-run.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RESULT_SIGNING_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Google Firebase Configuration (Web Client)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# Root System Administrator Credentials (Immune to full wipes & resets)
# ------------------------------------------------------------------------------
VITE_ADMIN_EMAIL="admin@edufeedback.edu"
VITE_ADMIN_PASSWORD=""
VITE_ADMIN_NAME="System Administrator"
