rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && 'email' in request.auth.token;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function emailKey(email) {
      return email.lower().replace('[^a-z0-9_-]', '_');
    }

    function myKey() {
      return emailKey(request.auth.token.email);
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(myKey());
    }

    function isActive() {
      return signedIn()
        && exists(myProfilePath())
        && get(myProfilePath()).data.status == 'active';
    }

    function myRole() {
      return get(myProfilePath()).data.role;
    }

    function isAdmin() {
      return isActive() && myRole() == 'superadmin';
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function surveyPath(sid) {
      return /databases/$(database)/documents/surveys/$(string(sid));
    }

    function myReceiptPath(sid) {
      return /databases/$(database)/documents/users/$(myKey())/receipts/$(string(sid));
    }

    match /topics/{topicId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {

      allow get: if isAdmin() || (signedIn() && userId.lower() == myKey());
      allow list: if isAdmin();

      allow create: if signedIn()
        && userId.lower() == myKey()
        && request.resource.data.email.lower() == myEmail()
        && (
          (request.resource.data.pos == 'Student'
            && request.resource.data.role in ['user', 'student']
            && request.resource.data.status == 'active')
          ||
          (request.resource.data.pos == 'Faculty'
            && request.resource.data.role == 'faculty'
            && request.resource.data.status == 'pending_approval')
          ||
          (request.resource.data.pos == 'Student Officer'
            && request.resource.data.role == 'officer'
            && request.resource.data.status == 'pending_approval')
        );

      allow update: if signedIn()
        && userId.lower() == myKey()
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'pos', 'status', 'email', 'joined',
                       'canCreateSurveys', 'canPostNews', 'restrictionReason']);

      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------- "already answered" records
    // One per person per survey. Holds only the survey id, with no answers or link to a
    // response. Only its owner can read it, and it can never be edited or deleted.
    match /users/{userId}/receipts/{surveyId} {
      allow read: if isActive() && userId == myKey();
      allow create: if isActive()
        && userId == myKey()
        && request.resource.data.keys().hasOnly(['surveyId'])
        && request.resource.data.surveyId == surveyId
        && exists(surveyPath(surveyId))
        && get(surveyPath(surveyId)).data.status in ['published', 'scheduled'];
    }

    // -------------------------------------------------------------- surveys
     match /surveys/{surveyId} {

      allow read: if isAdmin()
        || (isActive() && resource.data.status in ['published', 'scheduled'])
        || (isActive() && resource.data.owner == myEmail());

      allow create: if isActive()
        && request.resource.data.owner == myEmail()
        && request.resource.data.status in ['draft', 'pending']
        && request.resource.data.get('responses', 0) == 0
        && get(myProfilePath()).data.get('canCreateSurveys', true) == true;
      allow create: if isAdmin();

      allow update: if isActive()
        && resource.data.owner == myEmail()
        && request.resource.data.owner == resource.data.owner
        && (
          (resource.data.status in ['draft', 'rejected']
            && request.resource.data.status in ['draft', 'pending']
            && request.resource.data.get('responses', 0) == resource.data.get('responses', 0)
            && get(myProfilePath()).data.get('canCreateSurveys', true) == true)
          ||
          (resource.data.status == 'pending'
            && request.resource.data.status == 'draft')
          ||
          (resource.data.status in ['published', 'scheduled']
            && request.resource.data.status == 'archived'
            && onlyChanges(['status', 'archivedAt', 'archivedBy', 'archiveReason']))
        );
      allow update: if isAdmin();

      allow update: if isActive()
        && resource.data.status in ['published', 'scheduled']
        && onlyChanges(['responses'])
        && request.resource.data.responses >= resource.data.responses
        && request.resource.data.responses <= resource.data.responses + 1;

      allow delete: if isAdmin()
        || (isActive()
            && resource.data.owner == myEmail()
            && resource.data.status in ['draft', 'rejected']);
    }
    // ------------------------------------------------------------ responses
    match /responses/{responseId} {

      allow create: if isActive()
        && request.resource.data.surveyId != null
        && exists(surveyPath(request.resource.data.surveyId))
        && get(surveyPath(request.resource.data.surveyId)).data.status in ['published', 'scheduled']
        // One response per person: no earlier record, and the record is saved together with this response.
        && !exists(myReceiptPath(request.resource.data.surveyId))
        && existsAfter(myReceiptPath(request.resource.data.surveyId))
        && (
          (request.resource.data.get('isAnonymous', false) == true
            && request.resource.data.userEmail == 'anonymous@school.edu.ph')
          ||
          request.resource.data.userEmail.lower() == myEmail()
        );

      allow read: if isAdmin()
        || (isActive()
            && exists(surveyPath(resource.data.surveyId))
            && get(surveyPath(resource.data.surveyId)).data.owner.lower() == myEmail())
        || (isActive()
            && resource.data.get('isAnonymous', false) == false
            && resource.data.userEmail.lower() == myEmail());

      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------------------- news
    match /news/{newsId} {
      allow read: if isAdmin()
        || (isActive() && resource.data.status == 'published')
        || (isActive() && resource.data.authorEmail == myEmail());

      allow create: if isActive()
        && get(myProfilePath()).data.get('canPostNews', true) == true
        && request.resource.data.authorEmail == myEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.likesCount == 0
        && request.resource.data.get('isPinned', false) == false;

      allow delete: if isActive()
        && resource.data.authorEmail == myEmail()
        && resource.data.status in ['pending', 'rejected'];

      allow write: if isAdmin();

      allow update: if isActive()
        && resource.data.status == 'published'
        && onlyChanges(['likesCount'])
        && (request.resource.data.likesCount == resource.data.likesCount + 1
            || request.resource.data.likesCount == resource.data.likesCount - 1);
    }

    // ----------------------------------------------------------- ml_dataset
    match /ml_dataset/{sampleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------- logs
    match /logs/{logId} {
      allow create: if isActive();
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isActive() && resource.data.to == myEmail();
      allow create: if isActive()
        && request.resource.data.to is string
        && request.resource.data.to == request.resource.data.to.lower();
      allow update: if isActive()
        && resource.data.to == myEmail()
        && onlyChanges(['read']);
      allow delete: if isActive() && resource.data.to == myEmail();
      allow read, update, delete: if isAdmin();
    }
  }
}