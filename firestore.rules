rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Verified administrator gate
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@edufeedback.edu' ||
        request.auth.token.email == 'azalrob023@gmail.com'
      );
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 3. Surveys & Responses
    match /surveys/{surveyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /responses/{responseId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 4. Campus News & Announcements
    match /news/{newsId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 5. Tagalog NLP ML Training Dataset
    match /ml_dataset/{sampleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 6. System Activity & Audit Logs
    match /logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
