rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && 'email' in request.auth.token;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function emailKey(email) {
      return email.lower().replace('[^a-z0-9_-]', '_');
    }

    function myKey() {
      return emailKey(request.auth.token.email);
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(myKey());
    }

    function isActive() {
      return signedIn()
        && exists(myProfilePath())
        && get(myProfilePath()).data.status == 'active';
    }

    function myRole() {
      return get(myProfilePath()).data.role;
    }

    function isAdmin() {
      return isActive() && myRole() == 'superadmin';
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function surveyPath(sid) {
      return /databases/$(database)/documents/surveys/$(string(sid));
    }

    function myReceiptPath(sid) {
      return /databases/$(database)/documents/users/$(myKey())/receipts/$(string(sid));
    }

    function newsPath(nid) {
      return /databases/$(database)/documents/news/$(nid);
    }

    function myNewsLikePath(nid) {
      return /databases/$(database)/documents/users/$(myKey())/newsLikes/$(nid);
    }

    // Admin switch: is survey creation open? Open unless the admin has turned it off
    // (a missing settings document counts as open, so nothing breaks before it is set).
    function creationOpen() {
      let path = /databases/$(database)/documents/settings/app;
      return !exists(path) || get(path).data.get('surveyCreationOpen', true) == true;
    }

    // Is the signed-in person part of a survey's target audience?
    // Same mapping as the app: "students" = Student or Student Officer.
    function inAudience(survey) {
      let target = survey.get('targetAudience', {});
      let type = target.get('type', 'all');
      let roles = target.get('filters', {}).get('roles', []);
      let pos = get(myProfilePath()).data.pos;
      return type == 'all'
        || (type == 'students' && pos in ['Student', 'Student Officer'])
        || (type == 'faculty' && pos == 'Faculty')
        || (type == 'officers' && pos == 'Student Officer')
        || (type == 'custom' && (
              ('students' in roles && pos in ['Student', 'Student Officer'])
              || ('faculty' in roles && pos == 'Faculty')
              || ('officers' in roles && pos == 'Student Officer')));
    }

    // ------------------------------------------------------- academic calendar
    // One document per school year, id like "2026-2027".
    // Every active user can read it. Only the admin can write it.
    match /academic_calendar/{schoolYear} {
      allow read: if isActive();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && schoolYear.matches('^20[0-9]{2}-20[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['schoolYear', 'sem1Start', 'sem1End',
                                                 'sem2Start', 'sem2End', 'updatedAt', 'updatedBy'])
        && request.resource.data.schoolYear == schoolYear
        && request.resource.data.sem1Start is int
        && request.resource.data.sem1End is int
        && request.resource.data.sem2Start is int
        && request.resource.data.sem2End is int
        && request.resource.data.sem1Start < request.resource.data.sem1End
        && request.resource.data.sem1End < request.resource.data.sem2Start
        && request.resource.data.sem2Start < request.resource.data.sem2End
        && request.resource.data.updatedBy == myEmail();
    }

    // ------------------------------------------------------- app settings
    // One document "app" with switches the admin controls (e.g. surveyCreationOpen).
    // Every active user can read it; only the admin can change it.
    match /settings/{settingId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------- evaluation results
    // Saved results of the thesis sentiment evaluation (accuracy, macro-F1, ...).
    // Only the admin can read, add or delete them. They can never be edited.
    match /evaluation_runs/{runId} {
      allow read, create, delete: if isAdmin();
    }

    match /topics/{topicId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- users
    match /users/{userId} {

      allow get: if isAdmin() || (signedIn() && userId.lower() == myKey());
      allow list: if isAdmin();

      allow create: if signedIn()
        && userId.lower() == myKey()
        && request.resource.data.email.lower() == myEmail()
        && (
          (request.resource.data.pos == 'Student'
            && request.resource.data.role in ['user', 'student']
            && request.resource.data.status == 'active')
          ||
          (request.resource.data.pos == 'Faculty'
            && request.resource.data.role == 'faculty'
            && request.resource.data.status == 'pending_approval')
          ||
          (request.resource.data.pos == 'Student Officer'
            && request.resource.data.role == 'officer'
            && request.resource.data.status == 'pending_approval')
        );

      allow update: if signedIn()
        && userId.lower() == myKey()
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'pos', 'status', 'email', 'joined',
                       'canCreateSurveys', 'canPostNews', 'restrictionReason']);

      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------- "already answered" records
    // One per person per survey. Holds only the survey id, with no answers or link to a
    // response. Only its owner can read it, and it can never be edited or deleted.
    match /users/{userId}/receipts/{surveyId} {
      allow read: if isActive() && userId == myKey();
      allow create: if isActive()
        && userId == myKey()
        && request.resource.data.keys().hasOnly(['surveyId'])
        && request.resource.data.surveyId == surveyId
        && exists(surveyPath(surveyId))
        && get(surveyPath(surveyId)).data.status in ['published', 'scheduled'];
    }

    // One like per person per news post. Holds only the post id. Only its owner can read it.
    // It is created / deleted together with the post's like count going up / down by 1,
    // so the count cannot be pushed up by deleting and re-adding the record.
    match /users/{userId}/newsLikes/{newsId} {
      allow read: if isActive() && userId == myKey();
      allow create: if isActive()
        && userId == myKey()
        && request.resource.data.keys().hasOnly(['newsId'])
        && request.resource.data.newsId == newsId
        && get(newsPath(newsId)).data.status == 'published'
        && getAfter(newsPath(newsId)).data.likesCount == get(newsPath(newsId)).data.likesCount + 1;
      allow delete: if isActive()
        && userId == myKey()
        && getAfter(newsPath(newsId)).data.likesCount == get(newsPath(newsId)).data.likesCount - 1;
    }

    // -------------------------------------------------------------- surveys
     match /surveys/{surveyId} {

      allow read: if isAdmin()
        || (isActive() && resource.data.status in ['published', 'scheduled'])
        || (isActive() && resource.data.owner == myEmail());

      allow create: if isActive()
        && request.resource.data.owner == myEmail()
        && request.resource.data.status in ['draft', 'pending']
        && request.resource.data.get('responses', 0) == 0
        && get(myProfilePath()).data.get('canCreateSurveys', true) == true
        && creationOpen();
      allow create: if isAdmin();

      allow update: if isActive()
        && resource.data.owner == myEmail()
        && request.resource.data.owner == resource.data.owner
        && (
          (resource.data.status in ['draft', 'rejected']
            && request.resource.data.status in ['draft', 'pending']
            && request.resource.data.get('responses', 0) == resource.data.get('responses', 0)
            && get(myProfilePath()).data.get('canCreateSurveys', true) == true
            // While creation is off, drafts can still be saved but not sent for review.
            && (request.resource.data.status == 'draft' || creationOpen()))
          ||
          (resource.data.status == 'pending'
            && request.resource.data.status == 'draft')
          ||
          (resource.data.status in ['published', 'scheduled']
            && request.resource.data.status == 'archived'
            && onlyChanges(['status', 'archivedAt', 'archivedBy', 'archiveReason']))
        );
      allow update: if isAdmin();

      allow update: if isActive()
        && resource.data.status in ['published', 'scheduled']
        && onlyChanges(['responses'])
        && request.resource.data.responses >= resource.data.responses
        && request.resource.data.responses <= resource.data.responses + 1;

      allow delete: if isAdmin()
        || (isActive()
            && resource.data.owner == myEmail()
            && resource.data.status in ['draft', 'rejected']);
    }
    // ------------------------------------------------------------ responses
    match /responses/{responseId} {

      allow create: if isActive()
        && request.resource.data.surveyId != null
        && exists(surveyPath(request.resource.data.surveyId))
        && get(surveyPath(request.resource.data.surveyId)).data.status in ['published', 'scheduled']
        // Only people in the survey's target audience may answer.
        && inAudience(get(surveyPath(request.resource.data.surveyId)).data)
        // One response per person: no earlier record, and the record is saved together with this response.
        && !exists(myReceiptPath(request.resource.data.surveyId))
        && existsAfter(myReceiptPath(request.resource.data.surveyId))
        && (
          (request.resource.data.get('isAnonymous', false) == true
            && request.resource.data.userEmail == 'anonymous@school.edu.ph')
          ||
          request.resource.data.userEmail.lower() == myEmail()
        );

      allow read: if isAdmin()
        || (isActive()
            && exists(surveyPath(resource.data.surveyId))
            && get(surveyPath(resource.data.surveyId)).data.owner.lower() == myEmail())
        || (isActive()
            && resource.data.get('isAnonymous', false) == false
            && resource.data.userEmail.lower() == myEmail());

      allow update, delete: if isAdmin();

      // The survey's owner may flag a response in their own survey for the admin to review.
      // Only the "review" part changes; answers and results stay untouched. Only a response
      // that was never flagged can be flagged, and only as "flagged" (the admin decides).
      allow update: if isActive()
        && exists(surveyPath(resource.data.surveyId))
        && get(surveyPath(resource.data.surveyId)).data.owner.lower() == myEmail()
        && onlyChanges(['review'])
        && !('review' in resource.data)
        && request.resource.data.review.keys().hasOnly(['status', 'reasons', 'note', 'flaggedBy', 'flaggedAt'])
        && request.resource.data.review.status == 'flagged'
        && request.resource.data.review.flaggedBy == myEmail();
    }

    // ----------------------------------------------------------------- news
    match /news/{newsId} {
      allow read: if isAdmin()
        || (isActive() && resource.data.status == 'published')
        || (isActive() && resource.data.authorEmail == myEmail());

      allow create: if isActive()
        && get(myProfilePath()).data.get('canPostNews', true) == true
        && request.resource.data.authorEmail == myEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.likesCount == 0
        && request.resource.data.get('isPinned', false) == false;

      allow delete: if isActive()
        && resource.data.authorEmail == myEmail()
        && resource.data.status in ['pending', 'rejected'];

      allow write: if isAdmin();

      // Like / un-like: the count moves by 1 only together with this person's own like record.
      allow update: if isActive()
        && resource.data.status == 'published'
        && onlyChanges(['likesCount'])
        && ((request.resource.data.likesCount == resource.data.likesCount + 1
              && !exists(myNewsLikePath(newsId))
              && existsAfter(myNewsLikePath(newsId)))
          || (request.resource.data.likesCount == resource.data.likesCount - 1
              && exists(myNewsLikePath(newsId))
              && !existsAfter(myNewsLikePath(newsId))));
    }

    // ----------------------------------------------------------- ml_dataset
    match /ml_dataset/{sampleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------- logs
    match /logs/{logId} {
      allow create: if isActive();
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isActive() && resource.data.to == myEmail();
      allow create: if isActive()
        && request.resource.data.to is string
        && request.resource.data.to == request.resource.data.to.lower();
      allow update: if isActive()
        && resource.data.to == myEmail()
        && onlyChanges(['read']);
      allow delete: if isActive() && resource.data.to == myEmail();
      allow read, update, delete: if isAdmin();
    }
  }
}